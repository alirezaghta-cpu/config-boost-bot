# توکن ربات از BotFather
BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN

# آیدی عددی ادمین‌ها با ویرگول
ADMIN_IDS=123456789

# آیدی عددی کانال و گروه
CHANNEL_ID=-1001686062564
GROUP_ID=-1003793302941

# مخزن به‌شکل owner/repo
GITHUB_REPO=alirezaghta-cpu/config-boost-bot
GITHUB_TOKEN=ghp_REPLACE_WITH_GITHUB_TOKEN

# اطلاعات Cloudflare
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
KV_NAMESPACE_ID=REPLACE_WITH_KV_NAMESPACE_ID

# آدرس Worker؛ مسیر /test خودکار افزوده می‌شود
WORKER_URL=https://config-boost-tcp-test.example.workers.dev

# نام کاربری ربات بدون @
BOT_USERNAME=REPLACE_WITH_BOT_USERNAME

# اختیاری: اگر روی Worker راز مشترک تنظیم شده است
WORKER_SECRET=
